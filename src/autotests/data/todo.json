{
  "about": "Shared to-do block cases (docs/todo.md), run by web/test/todo.test.js and src/autotests/todotest.cpp. Lines are 0-based.",
  "cases": [
    {
      "name": "check moves to top of Done with today's date",
      "today": "2026-11-25",
      "input": "# Trip\n\n<!-- marknote-todo -->\n- [ ] Book flights\n- [ ] Pack charger\n\nAfter",
      "op": {
        "type": "toggle",
        "line": 4
      },
      "expected": "# Trip\n\n<!-- marknote-todo -->\n- [ ] Book flights\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] Pack charger ✅ 2026-11-25\n\n</details>\n\nAfter"
    },
    {
      "name": "second check goes above the first",
      "today": "2026-11-26",
      "input": "<!-- marknote-todo -->\n- [ ] Book flights\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] Pack charger ✅ 2026-11-25\n\n</details>",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n\n<details>\n<summary>Done (2)</summary>\n\n- [x] Book flights ✅ 2026-11-26\n- [x] Pack charger ✅ 2026-11-25\n\n</details>"
    },
    {
      "name": "uncheck moves to bottom of open list and drops the done date, keeps the due date",
      "today": "2026-11-26",
      "input": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] C 📅 2026-12-01 ✅ 2026-11-25\n\n</details>\n",
      "op": {
        "type": "toggle",
        "line": 7
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B\n- [ ] C 📅 2026-12-01\n"
    },
    {
      "name": "due date kept on completion; sub-notes travel with the item",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] Renew passport 📅 2026-12-01\n  Photo booth on Main St\n- [ ] Other",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n- [ ] Other\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] Renew passport 📅 2026-12-01 ✅ 2026-11-25\n  Photo booth on Main St\n\n</details>"
    },
    {
      "name": "set a due date",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B",
      "op": {
        "type": "due",
        "line": 2,
        "date": "2026-12-24"
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B 📅 2026-12-24"
    },
    {
      "name": "clear a due date",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] A 📅 2026-12-24",
      "op": {
        "type": "due",
        "line": 1,
        "date": null
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A"
    },
    {
      "name": "sort by due date: earliest first, undated last, stable",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] No date 1\n- [ ] Late 📅 2026-12-30\n- [ ] No date 2\n- [ ] Soon 📅 2026-11-28",
      "op": {
        "type": "sort",
        "line": 0,
        "sort": "due"
      },
      "expected": "<!-- marknote-todo sort=due -->\n- [ ] Soon 📅 2026-11-28\n- [ ] Late 📅 2026-12-30\n- [ ] No date 1\n- [ ] No date 2"
    },
    {
      "name": "in a due-sorted block, a new due date re-sorts",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo sort=due -->\n- [ ] Soon 📅 2026-11-28\n- [ ] Undated",
      "op": {
        "type": "due",
        "line": 2,
        "date": "2026-11-26"
      },
      "expected": "<!-- marknote-todo sort=due -->\n- [ ] Undated 📅 2026-11-26\n- [ ] Soon 📅 2026-11-28"
    },
    {
      "name": "back to manual keeps the current order",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo sort=due -->\n- [ ] Soon 📅 2026-11-28\n- [ ] Undated",
      "op": {
        "type": "sort",
        "line": 0,
        "sort": "manual"
      },
      "expected": "<!-- marknote-todo -->\n- [ ] Soon 📅 2026-11-28\n- [ ] Undated"
    },
    {
      "name": "items ticked by hand are moved to Done and stamped",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [x] Typed done\n- [ ] A\n- [ ] B",
      "op": {
        "type": "toggle",
        "line": 2
      },
      "expected": "<!-- marknote-todo -->\n- [ ] B\n\n<details>\n<summary>Done (2)</summary>\n\n- [x] Typed done ✅ 2026-11-25\n- [x] A ✅ 2026-11-25\n\n</details>"
    },
    {
      "name": "add an item",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] A\n\nText",
      "op": {
        "type": "add",
        "line": 0,
        "text": "New"
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n- [ ] New\n\nText"
    },
    {
      "name": "two blocks in one note are independent",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] A\n\n## Work\n\n<!-- marknote-todo -->\n- [ ] W1\n- [ ] W2",
      "op": {
        "type": "toggle",
        "line": 6
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n\n## Work\n\n<!-- marknote-todo -->\n- [ ] W2\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] W1 ✅ 2026-11-25\n\n</details>"
    },
    {
      "name": "a checklist outside a block is just toggled in place",
      "today": "2026-11-25",
      "input": "- [ ] A\n- [ ] B\n\n<!-- marknote-todo -->\n- [ ] C",
      "op": {
        "type": "toggle",
        "line": 0
      },
      "expected": "- [x] A\n- [ ] B\n\n<!-- marknote-todo -->\n- [ ] C"
    },
    {
      "name": "markers inside code fences are ignored",
      "today": "2026-11-25",
      "input": "```\n<!-- marknote-todo -->\n- [ ] A\n```",
      "op": {
        "type": "toggle",
        "line": 2
      },
      "expected": "```\n<!-- marknote-todo -->\n- [x] A\n```"
    },
    {
      "name": "make a to-do block from an existing checklist",
      "today": "2026-11-25",
      "input": "Intro\n\n- [ ] A\n- [x] B\n- [ ] C\n\nEnd",
      "op": {
        "type": "make",
        "line": 4
      },
      "expected": "Intro\n\n<!-- marknote-todo -->\n- [ ] A\n- [ ] C\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] B ✅ 2026-11-25\n\n</details>\n\nEnd"
    },
    {
      "name": "move an open item up, with its notes",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B\n- [ ] C\n  note on C\n\nAfter",
      "op": {
        "type": "move",
        "line": 3,
        "to": 0
      },
      "expected": "<!-- marknote-todo -->\n- [ ] C\n  note on C\n- [ ] A\n- [ ] B\n\nAfter"
    },
    {
      "name": "move an open item to the end",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B\n- [ ] C",
      "op": {
        "type": "move",
        "line": 1,
        "to": 2
      },
      "expected": "<!-- marknote-todo -->\n- [ ] B\n- [ ] C\n- [ ] A"
    },
    {
      "name": "moving by hand in a due-sorted block switches it to manual order",
      "today": "2026-11-25",
      "input": "<!-- marknote-todo sort=due -->\n- [ ] Soon 📅 2026-11-28\n- [ ] Later 📅 2026-12-30\n- [ ] Undated",
      "op": {
        "type": "move",
        "line": 3,
        "to": 0
      },
      "expected": "<!-- marknote-todo -->\n- [ ] Undated\n- [ ] Soon 📅 2026-11-28\n- [ ] Later 📅 2026-12-30"
    },
    {
      "name": "a sub-item checkbox is ticked in place, not the parent",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] Parent\n    - [ ] Child\n- [ ] Other",
      "op": {
        "type": "toggle",
        "line": 2
      },
      "expected": "<!-- marknote-todo -->\n- [ ] Parent\n    - [x] Child\n- [ ] Other"
    },
    {
      "name": "sub-items indented two spaces travel with their parent",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] Parent\n  - [ ] Child\n- [ ] Other",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n- [ ] Other\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] Parent ✅ 2026-11-28\n  - [ ] Child\n\n</details>"
    },
    {
      "name": "Windows line ends are kept",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\r\n- [ ] A\r\n- [ ] B\r\n",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\r\n- [ ] B\r\n\r\n<details>\r\n<summary>Done (1)</summary>\r\n\r\n- [x] A ✅ 2026-11-28\r\n\r\n</details>\r\n"
    },
    {
      "name": "blank lines inside an item stay with it",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] A\n    para1\n\n    para2\n- [ ] B",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n- [ ] B\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] A ✅ 2026-11-28\n    para1\n\n    para2\n\n</details>"
    },
    {
      "name": "a loose list stays one block",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] A\n\n- [ ] B\n\nAfter",
      "op": {
        "type": "toggle",
        "line": 3
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] B ✅ 2026-11-28\n\n</details>\n\nAfter"
    },
    {
      "name": "a lazily wrapped line stays with its item",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] A long item\nwrapped lazily\n- [ ] B",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n- [ ] B\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] A long item ✅ 2026-11-28\nwrapped lazily\n\n</details>"
    },
    {
      "name": "dates are only read at the end of the line",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] run `date -d 📅 2026-01-01` now\n- [ ] B",
      "op": {
        "type": "toggle",
        "line": 2
      },
      "expected": "<!-- marknote-todo -->\n- [ ] run `date -d 📅 2026-01-01` now\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] B ✅ 2026-11-28\n\n</details>"
    },
    {
      "name": "a marker inside a longer code fence is not a block",
      "today": "2026-11-28",
      "input": "````md\n```\n<!-- marknote-todo -->\n- [ ] x\n```\n````",
      "op": {
        "type": "toggle",
        "line": 3
      },
      "expected": "````md\n```\n<!-- marknote-todo -->\n- [x] x\n```\n````"
    },
    {
      "name": "a user details section after the list is left alone",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] A\n\n<details>\n<summary>Packing list</summary>\n\n- [x] socks\n\n</details>",
      "op": {
        "type": "add",
        "line": 0,
        "text": "B"
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B\n\n<details>\n<summary>Packing list</summary>\n\n- [x] socks\n\n</details>"
    },
    {
      "name": "an open Done section stays open",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] A\n- [ ] B\n\n<details open>\n<summary>Done (1)</summary>\n\n- [x] C ✅ 2026-11-20\n\n</details>",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n- [ ] B\n\n<details open>\n<summary>Done (2)</summary>\n\n- [x] A ✅ 2026-11-28\n- [x] C ✅ 2026-11-20\n\n</details>"
    },
    {
      "name": "an empty item keeps the space after the box",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] A",
      "op": {
        "type": "add",
        "line": 0,
        "text": ""
      },
      "expected": "<!-- marknote-todo -->\n- [ ] A\n- [ ] "
    },
    {
      "name": "a similar marker is not a block",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo-list -->\n- [ ] A\n- [ ] B",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo-list -->\n- [x] A\n- [ ] B"
    },
    {
      "name": "a checkbox in a block quote is ticked",
      "today": "2026-11-28",
      "input": "> - [ ] quoted\n> - [ ] other",
      "op": {
        "type": "toggle",
        "line": 0
      },
      "expected": "> - [x] quoted\n> - [ ] other"
    },
    {
      "name": "text right after the block is kept apart from it",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] a\n- [ ] b\n# Heading",
      "op": {
        "type": "toggle",
        "line": 1
      },
      "expected": "<!-- marknote-todo -->\n- [ ] b\n\n<details>\n<summary>Done (1)</summary>\n\n- [x] a ✅ 2026-11-28\n\n</details>\n\n# Heading"
    },
    {
      "name": "an added item is one line",
      "today": "2026-11-28",
      "input": "<!-- marknote-todo -->\n- [ ] a",
      "op": {
        "type": "add",
        "line": 0,
        "text": "pasted\nlines "
      },
      "expected": "<!-- marknote-todo -->\n- [ ] a\n- [ ] pasted lines"
    }
  ]
}
