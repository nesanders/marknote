<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                        http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="marknoterc" />
  <include>QFontDatabase</include>
  <group name="General">
    <entry name="sortBehaviour" type="String">
      <default code="true">QStringLiteral("sort-name")</default>
    </entry>
    <entry name="expandedSidebar" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showMenubar" type="Bool">
      <label>Show the menu bar</label>
      <default>true</default>
    </entry>
    <entry name="showFilterBar" type="Bool">
      <label>Show the filter bar below the notes list</label>
      <default>true</default>
    </entry>
    <entry name="showTagsColumn" type="Bool">
      <label>Show tags in the notes list</label>
      <default>true</default>
    </entry>
    <entry name="showCreatedColumn" type="Bool">
      <label>Show the created date in the notes list</label>
      <default>true</default>
    </entry>
    <entry name="filterSearchContents" type="Bool">
      <label>Filter also matches text inside notes</label>
      <default>false</default>
    </entry>
    <entry name="editorZoom" type="Int">
      <label>Editor zoom in percent</label>
      <default>100</default>
      <min>50</min>
      <max>300</max>
    </entry>
    <entry name="treeDensity" type="Int">
      <label>Notes list density: 0 compact, 1 normal, 2 comfortable</label>
      <default>1</default>
    </entry>
    <entry name="tagFilterMatchAny" type="Bool">
      <label>Tag filter matches notes with any selected tag instead of all</label>
      <default>false</default>
    </entry>
    <entry name="fillWindow" type="Bool">
      <default>false</default>
    </entry>
    <entry name="columnWidth" type="Int">
      <default>370</default>
    </entry>
    <entry name="storage" type="Path" key="storage">
      <default code="true">QStandardPaths::writableLocation(QStandardPaths::DocumentsLocation) + u'/' + QStringLiteral("Notes")</default>
    </entry>
    <entry name="colorScheme" type="String">
      <label>Color scheme</label>
    </entry>
    <entry name="useTranslucentBackground" type="Bool">
      <label>Enable translucent background</label>
      <default>false</default>
    </entry>
    <entry name="backgroundOpacity" type="Double">
      <label>Background opacity</label>
      <default>0.85</default>
      <min>0.75</min>
      <max>0.95</max>
    </entry>
    <entry name="textWidth" type="Int">
      <label>Text Width</label>
      <default>50</default>
    </entry>
    <entry name="fullWidth" type="Bool">
      <default>false</default>
    </entry>
  </group>

  <group name="Encryption">
    <entry name="autoLockMinutes" type="Int">
      <label>Lock encrypted notebooks after this many minutes without use (0: never)</label>
      <default>15</default>
    </entry>
  </group>

  <group name="Sync">
    <entry name="googleClientId" type="String">
      <label>Google OAuth client ID (empty: use the built-in one)</label>
    </entry>
    <entry name="googleClientSecret" type="String">
      <label>Google OAuth client secret</label>
    </entry>
    <entry name="googleAccount" type="String">
      <label>Signed-in Google account, for display</label>
    </entry>
    <entry name="autoSync" type="Bool">
      <label>Sync notebooks in the background while Marknote is open</label>
      <default>true</default>
    </entry>
    <entry name="autoSyncMinutes" type="Int">
      <label>Minutes between background syncs</label>
      <default>5</default>
    </entry>
  </group>

  <group name="Fonts">
    <entry name="EditorFont" type="Font" key="editor-font">
      <default code="true">QFontDatabase::systemFont(QFontDatabase::GeneralFont)</default>
    </entry>
  </group>
</kcfg>
