{
    "id": "org.kde.marknote",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "marknote",
    "tags": ["nightly"],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-documents"
    ],
    "separate-locales": false,

    "modules": [
        {
            "name": "kmime",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/pim/kmime"
                },
                {
                    "type": "shell",
                    "commands": [
                        "sed -i -E 's/set\\(KF_DEP_VERSION \"[0-9]+\\.[0-9]+\\.[0-9]+\"\\)/set(KF_DEP_VERSION \"6.24.0\")/' CMakeLists.txt",
                        "grep -qF 'set(KF_DEP_VERSION \"6.24.0\")' CMakeLists.txt || { echo 'kmime CMakeLists.txt no longer matches expected KF_DEP_VERSION pattern; update the sed in .flatpak-manifest.json'; exit 1; }",
                        "sed -i -E 's/find_package\\(ECM [0-9]+\\.[0-9]+\\.[0-9]+ NO_MODULE\\)/find_package(ECM 6.24.0 NO_MODULE)/' CMakeLists.txt",
                        "grep -qF 'find_package(ECM 6.24.0 NO_MODULE)' CMakeLists.txt || { echo 'kmime CMakeLists.txt no longer matches expected find_package(ECM ...) pattern; update the sed in .flatpak-manifest.json'; exit 1; }"
                    ]
                }
            ],
            "cleanup": [
                "/include",
                "/lib/cmake",
                "/share/qlogging-categories6"
            ]
        },
	{
            "name": "md4qt",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/libraries/md4qt"
                }
            ]
        },
        {
            "name": "marknote",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [ { "type": "dir", "path": ".", "skip": [".git"] } ]
        }
    ]
}

